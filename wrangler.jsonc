{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gm-paulskenes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  }
}
